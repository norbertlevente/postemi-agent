{
  "name": "postemi",
  "version": "1.1.1",
  "description": "Postemi CLI - schedule and publish social media posts from the command line or from your AI agent: 37 platforms and apps, including Facebook, Instagram, X, LinkedIn, TikTok, YouTube, Threads, Bluesky, Pinterest and Mastodon.",
  "main": "dist/index.js",
  "bin": {
    "postemi": "dist/index.js"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p .",
    "start": "node ./dist/index.js",
    "prepublishOnly": "pnpm run build",
    "release:check": "tsup && npm pack --dry-run && npm publish --dry-run",
    "test": "tsc --noEmit -p . && tsup && node scripts/unit-tests.mjs && node scripts/check.mjs",
    "sync:templates": "node scripts/sync-templates.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "test:unit": "node scripts/unit-tests.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "skills",
    "PROVIDER_SETTINGS.md",
    "SUPPORTED_FILE_TYPES.md",
    "examples",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "postemi",
    "cli",
    "social-media",
    "scheduling",
    "automation",
    "ai-agent",
    "command-line",
    "x",
    "twitter",
    "facebook",
    "instagram",
    "threads",
    "bluesky",
    "youtube",
    "linkedin",
    "tiktok",
    "pinterest",
    "mcp",
    "scheduler",
    "social-media-scheduler",
    "posts"
  ],
  "author": "Kiss Industries",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/norbertlevente/postemi-agent.git"
  },
  "homepage": "https://postemi.com",
  "bugs": {
    "url": "https://github.com/norbertlevente/postemi-agent/issues",
    "email": "norbert@postemi.com"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/yargs": "^17.0.32",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
